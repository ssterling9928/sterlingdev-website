---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets' // Import Astro's image component for optimized image handling

import PortraitImage from '../assets/images/portrait.jpg' // Import my portrait image
---

<Layout title="Stephen Sterling - Portfolio">
    <!-- 
  ======================================================================
  HERO SECTION
  ======================================================================
  This section is designed as a first introduction to me on the homepage.
-->
    <section id="hero-section" class="home-hero">
        <div class="home-hero-inner container md:flex-row">
            <!-- Text Content -->
            <div class="home-hero-text md:text-left">
                <p class="home-hero-greeting md:text-2xl">Hello, I'm</p>
                <h1 class="home-hero-name md:text-6xl lg:text-7xl">
                    <span>Stephen Sterling</span>
                </h1>
                <p class="home-hero-tagline md:text-3xl">
                    A <span class="home-hero-role">Full-Stack Developer</span> Creating
                    a diversified array of software and web applications.
                </p>

                <!-- Call to Action Button -->
                <a href="/myWork/" class="cta-button"> View My Work </a>
            </div>

            <!-- Picture -->
            <div class="home-portrait">
                <div class="home-portrait-glow"></div>
                <Image
                    src={PortraitImage}
                    alt={"Stephen Sterling's Portrait"}
                    width="1920"
                    height="1080"
                    class="home-portrait-img md:size-80 lg:size-96"
                />
            </div>
        </div>
    </section>

    <!-- 
  ======================================================================
  SKILLS SECTION
  ======================================================================
  This section is designed as a quick look at my skills on the homepage.
-->

    <!-- Main Content Container:
    - `container mx-auto` centers it and applies a max-width.
    -->
    <section class="home-toolkit container">
        <!-- Section Header -->
        <h2 class="home-section-title md:text-5xl">My Creative Toolkit</h2>
        <p class="home-section-subtitle">
            A blend of technical expertise and creative problem-solving to build
            robust and beautiful applications.
        </p>

        <!-- Grid for the glass panes -->
        <div class="card-grid md:grid-cols-2 lg:grid-cols-3">
            <!-- Card 1: Game & 3D Worlds -->
            <div>
                <h3 class="skill-heading">Games & 3D Worlds</h3>
                <p class="skill-text">
                    Building immersive experiences from the ground up using
                    industry-standard tools like Unreal Engine, Unity, C++, and
                    C#.
                </p>
            </div>

            <!-- Card 2: Web & App Ecosystems -->
            <div>
                <h3 class="skill-heading">Web & App Ecosystems</h3>
                <p class="skill-text">
                    Crafting high-performance websites and native applications
                    with modern frameworks like Astro, Swift, and .NET.
                </p>
            </div>

            <!-- Card 3: Foundational Strengths (Added) -->
            <div>
                <h3 class="skill-heading">Foundational Strengths</h3>
                <p class="skill-text">
                    Driven by a passion for rapid and self learning, grounded in
                    advanced mathematics, and streamlined with tools like Git.
                </p>
            </div>
        </div>

        <!-- Call to Action Button -->
        <div class="home-toolkit-cta">
            <a href="/skills/" class="cta-button"> Explore All Skills </a>
        </div>
    </section>

    <!-- 
  ======================================================================
  CONTACT SECTION
  ======================================================================
  This section is designed as a final call-to-action on the homepage.
-->
    <section id="contact" class="home-contact md:py-32">
        <div class="container-padded container">
            <!-- Main Invitation-Style Card -->
            <div class="home-contact-card md:p-12">
                <h2 class="home-contact-title md:text-5xl">
                    Have a project in mind? <br />
                    <span>Let's build it.</span>
                </h2>

                <p class="home-contact-text">
                    I'm currently available for freelance and career
                    opportunities. If you're looking for a developer who is
                    passionate about bringing new ideas to life, I'm ready to
                    connect.
                </p>

                <div class="home-contact-actions">
                    <button
                        data-metric-id="open-contact-modal"
                        class="open-contact-modal cta-button"
                    >
                        Let's Connect
                    </button>
                </div>
            </div>
        </div>
    </section>
</Layout>
