---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets' // Import Astro's image component for optimized image handling
import type { ImageMetadata } from 'astro'

import PortraitImage from '../assets/images/portrait.jpg'
import InteractiveTerminal from '../components/InteractiveTerminal.astro'
import { projects } from '../data/projects'

// Only featured projects appear on the home page; /myWork/ shows them all.
const featured = projects.filter(
    (project): project is typeof project & { image: ImageMetadata } =>
        project.featured && project.image !== undefined
)
---

<Layout title="Stephen Sterling - Portfolio">
    <!--
  ======================================================================
  HERO SECTION
  ======================================================================
  A shell-style introduction: `$ whoami` followed by who I am.
-->
    <section class="home-hero">
        <div
            class="home-hero-inner container md:grid-cols-[1.4fr_1fr] md:px-12 md:py-24"
        >
            <div class="home-hero-text">
                <p class="term-prompt">
                    <span class="term-dollar">$</span> whoami
                </p>
                <h1 class="home-hero-name sm:text-5xl md:text-6xl lg:text-7xl">
                    Stephen <span class="nowrap"
                        >Sterling<span class="term-cursor" aria-hidden="true"
                        ></span></span
                    >
                </h1>
                <ul class="term-lines md:text-lg">
                    <li>full-stack developer</li>
                    <li>games · web · iOS</li>
                    <li>Unreal, Unity, Swift, Astro, .NET</li>
                </ul>
                <div class="home-hero-actions">
                    <a href="/myWork/" class="cta-button">./view-work</a>
                    <button
                        data-metric-id="open-contact-modal"
                        class="open-contact-modal cta-button cta-button-ghost"
                    >
                        ./contact
                    </button>
                </div>
            </div>

            <div class="home-portrait md:justify-self-center">
                <Image
                    src={PortraitImage}
                    alt="Stephen Sterling"
                    width={600}
                    class="home-portrait-img md:size-72 lg:size-80"
                    loading="eager"
                />
                <p class="status-badge md:-left-6">available for work</p>
            </div>
        </div>
    </section>

    <!--
  ======================================================================
  FEATURED PROJECTS
  ======================================================================
  Work comes first: three projects, each linking to where you can try it.
-->
    <section class="home-section container md:px-12">
        <div class="section-label-row">
            <h2 class="section-label"><span>//</span> featured_projects</h2>
            <a href="/myWork/" class="section-link">ls ~/work →</a>
        </div>

        <div class="feature-grid md:grid-cols-3">
            {
                featured.map((project) => (
                    <a
                        href={project.href}
                        class="feature-card"
                        data-metric-id={project.metricId}
                        {...(project.external
                            ? { target: '_blank', rel: 'noopener' }
                            : {})}
                    >
                        <div
                            class:list={[
                                'feature-card-thumb',
                                project.imageClass,
                            ]}
                        >
                            <Image
                                src={project.image}
                                alt={project.imageAlt ?? ''}
                                width={640}
                            />
                        </div>
                        <div class="feature-card-body">
                            <span class="feature-card-file">
                                {project.file}
                            </span>
                            <h3 class="feature-card-title">{project.title}</h3>
                            <p class="feature-card-text">
                                {project.description}
                            </p>
                            <div class="tag-list">
                                {project.tags.map((tag) => (
                                    <span class="term-tag">{tag}</span>
                                ))}
                            </div>
                            <span class="feature-card-action">
                                → {project.action}
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>

    <!--
  ======================================================================
  INTERACTIVE TERMINAL
  ======================================================================
  A small shell visitors can type commands into.
-->
    <section class="home-section container md:px-12">
        <div class="section-label-row">
            <h2 class="section-label"><span>//</span> terminal</h2>
            <span class="section-hint">type <code>help</code> to explore</span>
        </div>
        <InteractiveTerminal />
    </section>

    <!--
  ======================================================================
  CONTACT SECTION
  ======================================================================
  A final call-to-action, drawn as a terminal window.
-->
    <section id="contact" class="home-section container md:px-12 md:pb-32">
        <div class="term-window">
            <div class="term-window-bar">
                <span class="term-window-dot"></span>
                <span class="term-window-dot"></span>
                <span class="term-window-dot"></span>
                <span class="term-window-title">contact.sh</span>
            </div>
            <div class="term-window-body md:p-12">
                <p class="term-prompt">
                    <span class="term-dollar">$</span> ./contact --new-project
                </p>
                <h2 class="home-contact-title md:text-5xl">
                    Have a project in mind?
                    <span>Let's build it.</span>
                </h2>
                <p class="home-contact-text">
                    I'm currently available for freelance and career
                    opportunities. If you're looking for a developer who is
                    passionate about bringing new ideas to life, I'm ready to
                    connect.
                </p>
                <button
                    data-metric-id="open-contact-modal"
                    class="open-contact-modal cta-button"
                >
                    ./connect
                </button>
            </div>
        </div>
    </section>
</Layout>
