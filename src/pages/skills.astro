---
import Layout from '../layouts/Layout.astro'
import Image from 'astro/components/Image.astro'

import unity2Dcert from '../assets/certs/png/completeUnity2D-1.png'
import gitUnrealcert from '../assets/certs/png/gitUnreal-1.png'
import csharpcert from '../assets/certs/png/intermediatecsharp-1.png'
import photoshopcert from '../assets/certs/png/photoshop-1.png'
import unitymobilecert from '../assets/certs/png/unityMobile-1.png'
import unrealblueprintscert from '../assets/certs/png/unrealBlueprints-1.png'
import wordpresscert from '../assets/certs/png/wordpress-1.png'
---

<Layout title="Stephen Sterling - My Skills">
    <!-- Skills Hero Section -->
    <section
        id="hero-section"
        class="flex w-full items-center justify-center overflow-hidden py-48 text-center md:py-72"
    >
        <!-- Content -->
        <div class="z-10">
            <h1
                class="text-6xl font-bold leading-tight text-text md:text-8xl lg:text-9xl"
            >
                The Toolkit<span class="text-accent">.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-3xl text-xl text-text md:text-2xl">
                Here you'll find the skills, credentials, and technologies I use
                to bring ideas to life.
            </p>
        </div>
    </section>

    <section>
        <div class="w-full p-8 py-32">
            <!-- Soft Skills Section -->
            <div class="container z-10 mx-auto">
                <div class="mx-auto max-w-5xl text-center">
                    <h3 class="text-5xl font-bold text-text">
                        Core Strengths
                    </h3>
                    <div class="underline-title"></div>
                </div>
                <p class="mt-4 pb-8 text-center text-lg text-text">
                    My skillset beyond just coding.
                </p>

                <div class="mb-32 flex flex-wrap justify-center gap-4">
                    <span
                        class="rounded-full bg-surface px-5 py-2 text-lg font-medium text-text"
                        >Team Collaboration</span
                    >
                    <span
                        class="rounded-full bg-surface px-5 py-2 text-lg font-medium text-text"
                        >Problem-Solving</span
                    >
                    <span
                        class="rounded-full bg-surface px-5 py-2 text-lg font-medium text-text"
                        >Adaptability</span
                    >
                    <span
                        class="rounded-full bg-surface px-5 py-2 text-lg font-medium text-text"
                        >Communication</span
                    >
                    <span
                        class="rounded-full bg-surface px-5 py-2 text-lg font-medium text-text"
                        >Rapid Learning</span
                    >
                </div>
            </div>

            <!-- Technical Skills Section -->
            <div class="text-center">
                <h2 class="text-5xl font-bold text-text">
                    Technical Skills
                </h2>
                <div class="underline-title"></div>
                <p class="mt-4 pb-8 text-lg text-text">
                    A comprehensive list of the technologies I've worked with.
                </p>
            </div>

            <div
                class="mx-auto mb-32 max-w-5xl p-8 md:p-12"
            >
                <div
                    class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3"
                >
                    <!-- Column 1: Game Development -->
                    <div class="space-y-4">
                        <h3
                            class="border-b-2 pb-2 text-2xl text-accent"
                        >
                            Game Development
                        </h3>
                        <ul
                            class="grid grid-cols-2 pt-2 text-sm md:grid-cols-none md:space-y-2 md:text-lg"
                        >
                            <li>Unreal Engine</li>
                            <li>Unity Engine</li>
                            <li>C++</li>
                            <li>C#</li>
                        </ul>
                    </div>

                    <!-- Column 2: Web & Application -->
                    <div class="space-y-4">
                        <h3
                            class="border-b-2 pb-2 text-2xl text-accent"
                        >
                            Web & Application
                        </h3>
                        <ul
                            class="grid grid-cols-2 pt-2 text-sm md:grid-cols-none md:space-y-2 md:text-lg"
                        >
                            <li>Astro</li>
                            <li>HTML & CSS</li>
                            <li>JavaScript</li>
                            <li>Tailwind CSS</li>
                            <li>Swift (for iOS)</li>
                            <li>.NET Framework</li>
                        </ul>
                    </div>

                    <!-- Column 3: Tools & Platforms -->
                    <div class="space-y-4">
                        <h3
                            class="border-b-2 pb-2 text-2xl text-accent"
                        >
                            Tools & Platforms
                        </h3>
                        <ul
                            class="grid grid-cols-2 pt-2 text-sm md:grid-cols-none md:space-y-2 md:text-lg"
                        >
                            <li>Git & GitHub</li>
                            <li>Visual Studio</li>
                            <li>Xcode</li>
                            <li>Cloud Services</li>
                            <li>Google Workspace</li>
                            <li>Microsoft Office</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="mx-auto max-w-5xl text-center">
                <h3 class="text-5xl font-bold text-text">
                    Development Philosophy
                </h3>
                <div class="underline-title"></div>
                <p class="mt-4 pb-8 text-lg text-text">
                    The principles that guide my work.
                </p>
                <div class="grid grid-cols-1 gap-8 text-left md:grid-cols-3">
                    <div
                        class="rounded-lg p-6"
                    >
                        <h4 class="text-xl font-semibold text-accent">
                            Performance First
                        </h4>
                        <p class="mt-2 text-text">
                            I build applications to be as fast and efficient as
                            possible, because speed is a critical feature for a
                            great user experience.
                        </p>
                    </div>
                    <div
                        class="rounded-lg p-6"
                    >
                        <h4 class="text-xl font-semibold text-accent">
                            Clean & Maintainable
                        </h4>
                        <p class="mt-2 text-text">
                            I write code that is not only effective but also
                            easy for others—and my future self—to understand,
                            debug, and build upon.
                        </p>
                    </div>
                    <div
                        class="rounded-lg p-6"
                    >
                        <h4 class="text-xl font-semibold text-accent">
                            User-Centric Design
                        </h4>
                        <p class="mt-2 text-text">
                            Technology should serve people. I focus on creating
                            intuitive and accessible interfaces that solve real
                            problems for the end-user.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Certificates Section -->
    <section class="mx-auto">
        <div class="w-full p-8 py-32">
            <div class="container mx-auto">
                <div class="text-center">
                    <h2
                        class="text-2xl font-bold text-text md:text-5xl"
                    >
                        Education & Certifications
                    </h2>
                    <div class="underline-title"></div>
                    <p class="text-lg text-text">
                        My formal education and commitment to continuous
                        learning.
                    </p>
                </div>

                <!-- Tier 1: Degree -->
                <div
                    class="my-24 rounded-2xl p-8"
                >
                    <div
                        class="flex flex-col items-center gap-6 text-center md:flex-row md:text-left"
                    >
                        <svg
                            class="h-16 w-16 flex-shrink-0 text-text"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0l-2.072-1.036A48.426 48.426 0 0112 4.5c5.052 0 9.842 1.353 13.5 3.675l-2.072 1.036m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5z"
                            ></path></svg
                        >
                        <div>
                            <h3 class="text-3xl text-text">
                                Bachelor of Science in Information Technology
                            </h3>
                            <p class="text-lg text-text">
                                University of Massuchussets Lowell - Graduated
                                2024
                            </p>
                        </div>
                        <a
                            href="/assets/certs/pdf/sterling-bachelors.pdf"
                            target="_blank"
                            class="button"
                            data-metric-id="view-degree">View</a
                        >
                    </div>
                </div>

                <!-- Tier 2: Featured Certificates Carousel -->
                <div class="">
                    <h3 class="mb-10 text-center text-3xl text-text">
                        Udemy Certificates
                    </h3>
                    <div class="relative mx-auto max-w-6xl">
                        <!-- Carousel Wrapper -->
                        <div
                            id="carousel-container"
                            class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth py-4"
                        >
                            <div
                                class="w-full flex-shrink-0 snap-center px-4 md:w-1/2 lg:w-1/3"
                            >
                                <div
                                    class="featured-cert flex h-full flex-col rounded-xl p-6"
                                >
                                    <Image
                                        src={unity2Dcert}
                                        alt="Complete Unity 2D Certificate"
                                        class="mb-4 h-48 w-full rounded-lg object-cover"
                                    />
                                    <div class="flex-grow">
                                        <h4
                                            class="text-xl text-text"
                                        >
                                            C# Unity Developer
                                        </h4>
                                        <p class="text-text">Udemy</p>
                                    </div>
                                    <a
                                        href="/assets/certs/pdf/completeUnity2D.pdf"
                                        target="_blank"
                                        class="mt-4 block w-full rounded-lg px-4 py-2 text-center text-text transition-colors"
                                        data-metric-id="view-completeUnity2D"
                                        >View Certificate</a
                                    >
                                </div>
                            </div>
                            <div
                                class="w-full flex-shrink-0 snap-center px-4 md:w-1/2 lg:w-1/3"
                            >
                                <div
                                    class="featured-cert flex h-full flex-col rounded-xl p-6"
                                >
                                    <Image
                                        src={unrealblueprintscert}
                                        alt="Unreal Engine Blueprints Certificate"
                                        class="mb-4 h-48 w-full rounded-lg object-cover"
                                    />
                                    <div class="flex-grow">
                                        <h4
                                            class="text-xl text-text"
                                        >
                                            Unreal Engine 5 Blueprints FPS
                                        </h4>
                                        <p class="text-text">Udemy</p>
                                    </div>
                                    <a
                                        href="/assets/certs/pdf/unrealBlueprints.pdf"
                                        target="_blank"
                                        class="mt-4 block w-full rounded-lg px-4 py-2 text-center text-text transition-colors"
                                        data-metric-id="view-unrealBlueprints"
                                        >View Certificate</a
                                    >
                                </div>
                            </div>
                            <div
                                class="w-full flex-shrink-0 snap-center px-4 md:w-1/2 lg:w-1/3"
                            >
                                <div
                                    class="featured-cert flex h-full flex-col rounded-xl p-6"
                                >
                                    <Image
                                        src={csharpcert}
                                        alt="Intermediate C# Certificate"
                                        class="mb-4 h-48 w-full rounded-lg object-cover"
                                    />
                                    <div class="flex-grow">
                                        <h4
                                            class="text-xl text-text"
                                        >
                                            Intermediate C#
                                        </h4>
                                        <p class="text-text">Udemy</p>
                                    </div>
                                    <a
                                        href="/assets/certs/pdf/intermediatecsharp.pdf"
                                        target="_blank"
                                        class="mt-4 block w-full rounded-lg px-4 py-2 text-center text-text transition-colors"
                                        data-metric-id="view-intermediatecsharp"
                                        >View Certificate</a
                                    >
                                </div>
                            </div>
                            <div
                                class="w-full flex-shrink-0 snap-center px-4 md:w-1/2 lg:w-1/3"
                            >
                                <div
                                    class="featured-cert flex h-full flex-col rounded-xl p-6"
                                >
                                    <Image
                                        src={photoshopcert}
                                        alt="Photoshop Certificate"
                                        class="mb-4 h-48 w-full rounded-lg object-cover"
                                    />
                                    <div class="flex-grow">
                                        <h4
                                            class="text-xl text-text"
                                        >
                                            Adobe Photoshop
                                        </h4>
                                        <p class="text-text">Udemy</p>
                                    </div>
                                    <a
                                        href="/assets/certs/pdf/photoshop.pdf"
                                        target="_blank"
                                        class="mt-4 block w-full rounded-lg px-4 py-2 text-center text-text transition-colors"
                                        data-metric-id="view-photoshop"
                                        >View Certificate</a
                                    >
                                </div>
                            </div>
                            <div
                                class="w-full flex-shrink-0 snap-center px-4 md:w-1/2 lg:w-1/3"
                            >
                                <div
                                    class="featured-cert flex h-full flex-col rounded-xl p-6"
                                >
                                    <Image
                                        src={gitUnrealcert}
                                        alt="Git with Unreal Engine Certificate"
                                        class="mb-4 h-48 w-full rounded-lg object-cover"
                                    />
                                    <div class="flex-grow">
                                        <h4
                                            class="text-xl text-text"
                                        >
                                            Git with Applications for Unreal
                                            Engine
                                        </h4>
                                        <p class="text-text">Udemy</p>
                                    </div>
                                    <a
                                        href="/assets/certs/pdf/gitUnreal.pdf"
                                        target="_blank"
                                        class="mt-4 block w-full rounded-lg px-4 py-2 text-center text-text transition-colors"
                                        data-metric-id="view-gitUnreal"
                                        >View Certificate</a
                                    >
                                </div>
                            </div>
                            <div
                                class="w-full flex-shrink-0 snap-center px-4 md:w-1/2 lg:w-1/3"
                            >
                                <div
                                    class="featured-cert flex h-full flex-col rounded-xl p-6"
                                >
                                    <Image
                                        src={wordpresscert}
                                        alt="Wordpress Certificate"
                                        class="mb-4 h-48 w-full rounded-lg object-cover"
                                    />
                                    <div class="flex-grow">
                                        <h4
                                            class="text-xl text-text"
                                        >
                                            Wordpress Development
                                        </h4>
                                        <p class="text-text">Udemy</p>
                                    </div>
                                    <a
                                        href="/assets/certs/pdf/wordpress.pdf"
                                        target="_blank"
                                        class="mt-4 block w-full rounded-lg px-4 py-2 text-center text-text transition-colors"
                                        data-metric-id="view-wordpress"
                                        >View Certificate</a
                                    >
                                </div>
                            </div>
                            <div
                                class="w-full flex-shrink-0 snap-center px-4 md:w-1/2 lg:w-1/3"
                            >
                                <div
                                    class="featured-cert flex h-full flex-col rounded-xl p-6"
                                >
                                    <Image
                                        src={unitymobilecert}
                                        alt="Unity Mobile Certificate"
                                        class="mb-4 h-48 w-full rounded-lg object-cover"
                                    />
                                    <div class="flex-grow">
                                        <h4
                                            class="text-xl text-text"
                                        >
                                            C# Unity Mobile
                                        </h4>
                                        <p class="text-text">Udemy</p>
                                    </div>
                                    <a
                                        href="/assets/certs/pdf/unityMobile.pdf"
                                        target="_blank"
                                        class="mt-4 block w-full rounded-lg px-4 py-2 text-center text-text transition-colors"
                                        data-metric-id="view-unityMobile"
                                        >View Certificate</a
                                    >
                                </div>
                            </div>
                        </div>
                        <!-- Carousel Buttons -->
                        <button
                            id="prev-btn"
                            class="group absolute left-[-2rem] top-1/2 -translate-y-1/2 rounded-full bg-gray-800/50 p-2 transition-colors hover:bg-gray-800"
                        >
                            <svg
                                class="h-6 w-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>
                        <button
                            id="next-btn"
                            class="group absolute right-[-2rem] top-1/2 -translate-y-1/2 rounded-full bg-gray-800/50 p-2 text-white transition-colors hover:bg-gray-800"
                        >
                            <svg
                                class="h-6 w-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Tier 3: Other Certificates -->
                <div class="mt-16">
                    <div
                        class="mx-auto max-w-4xl rounded-lg p-6"
                    >
                        <h3
                            class="mb-10 text-center text-3xl text-white"
                        >
                            Additional and Ongoing Courses
                        </h3>

                        <div
                            class="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2"
                        >
                            <p class="text-text">
                                Unreal Engine 5: Intermediate
                            </p>
                            <p class="text-text">
                                Unreal Engine 5: Dedicated Servers with AWS
                            </p>
                            <p class="text-text">
                                Complete Full-Stack Web Developer
                            </p>
                            <p class="text-text">
                                Unreal Engine 5: Gameplay Ability System
                            </p>
                            <p class="text-text">Modern React</p>
                            <p class="text-text">
                                JavaScript Algorithms and Data Structures
                            </p>
                            <p class="text-text">
                                Creating 3D Environments in Blender
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Call to Action Section -->
            <div class="pt-24 text-center">
                <h3 class="text-3xl font-bold text-text">
                    See My Skills in Action
                </h3>
                <p class="mt-2 text-lg text-text">
                    Check out my portfolio of projects.
                </p>
                <a
                    href="/myWork/"
                    class="cta-button inline-block"
                >
                    View My Work
                </a>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const carousel = document.getElementById('carousel-container')
            const prevBtn = document.getElementById('prev-btn')
            const nextBtn = document.getElementById('next-btn')

            if (carousel && nextBtn && prevBtn) {
                let scrollAmount = 0
                const firstCard = carousel.querySelector('.flex-shrink-0')

                if (firstCard) {
                    scrollAmount = firstCard.getBoundingClientRect().width
                }

                nextBtn.addEventListener('click', () => {
                    window.requestAnimationFrame(() => {
                        carousel.scrollLeft += scrollAmount
                    })
                })
                prevBtn.addEventListener('click', () => {
                    window.requestAnimationFrame(() => {
                        carousel.scrollLeft -= scrollAmount
                    })
                })
            }
        })
    </script>
</Layout>
