---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'

import { certs, degree } from '../data/certs'

// --- Certificate totals (shown in the ls -l listing) -----------------------
const totalHours = certs.reduce((sum, cert) => sum + cert.hours, 0)

// "2021-03" -> "Mar 2021"
const formatDate = (date: string) =>
    new Date(`${date}-01T00:00:00Z`).toLocaleDateString('en-US', {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
    })

// --- Technical skills ------------------------------------------------------
const stack = [
    {
        folder: 'games/',
        skills: [
            'Unreal Engine',
            'Blueprints',
            'Unity',
            'C++',
            'C#',
            'Blender',
            'Photoshop',
            'Visual Studio',
            'Rider',
        ],
    },
    {
        folder: 'devops_and_tools/',
        skills: [
            'Docker',
            'Kubernetes',
            'Linux',
            'Windows',
            'macOS',
            'Proxmox',
            'Servers',
            'CI/CD',
            'Python',
            'Bash',
            'Git & GitHub',
            'Grafana & Prometheus',
            'Cloud Services',
            'Google Workspace',
            'Microsoft Office',
        ],
    },
    {
        folder: 'web_and_apps/',
        skills: [
            'React',
            'Astro',
            'HTML & CSS',
            'JavaScript',
            'TypeScript',
            'Node.js',
            'Express',
            'Tailwind CSS',
            'Swift (iOS)',
            'Xcode',
            '.NET',
        ],
    },
]

const strengths = [
    'Team Collaboration',
    'Problem-Solving',
    'Adaptability',
    'Communication',
    'Rapid Learning',
]

const philosophy = [
    {
        title: 'Performance First',
        text: 'I build applications to be as fast and efficient as possible, because speed is a critical feature for a great user experience.',
    },
    {
        title: 'Clean & Maintainable',
        text: 'I write code that is not only effective but also easy for others—and my future self—to understand, debug, and build upon.',
    },
    {
        title: 'User-Centric Design',
        text: 'Technology should serve people. I focus on creating intuitive and accessible interfaces that solve real problems for the end-user.',
    },
]
---

<Layout title="Stephen Sterling - My Skills">
    <!--
  ======================================================================
  HEADER: "Always learning." + stats
  ======================================================================
-->
    <section class="skills-hero">
        <div class="skills-hero-inner container md:px-12 md:py-20">
            <div>
                <p class="term-prompt">
                    <span class="term-dollar">$</span> history | grep learn
                </p>
                <h1 class="skills-title md:text-6xl lg:text-7xl">
                    Always <span class="nowrap"
                        ><span class="skills-title-accent">learning.</span><span
                            class="term-cursor"
                            aria-hidden="true"></span></span
                    >
                </h1>
                <p class="skills-subtitle md:text-xl">
                    The skills, credentials, and technologies I use to bring
                    ideas to life.
                </p>
            </div>
        </div>
    </section>

    <!--
  ======================================================================
  STACK
  ======================================================================
-->
    <section class="home-section container md:px-12">
        <div class="section-label-row">
            <h2 class="section-label"><span>//</span> stack</h2>
        </div>
        <div class="stack-grid md:grid-cols-3">
            {
                stack.map((group) => (
                    <div class="stack-card">
                        <h3 class="stack-card-title">
                            {group.folder}
                            <span class="stack-count">
                                {group.skills.length}
                            </span>
                        </h3>
                        <ul class="tag-list">
                            {group.skills.map((skill) => (
                                <li class="term-tag">{skill}</li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </section>

    <!--
  ======================================================================
  CORE STRENGTHS
  ======================================================================
-->
    <section class="home-section container md:px-12">
        <div class="section-label-row">
            <h2 class="section-label"><span>//</span> core_strengths</h2>
        </div>
        <ul class="strength-list">
            {
                strengths.map((strength) => (
                    <li class="strength-pill">{strength}</li>
                ))
            }
        </ul>
    </section>

    <!--
  ======================================================================
  PHILOSOPHY
  ======================================================================
-->
    <section class="home-section container md:px-12">
        <div class="section-label-row">
            <h2 class="section-label"><span>//</span> philosophy</h2>
        </div>
        <div class="philosophy-grid md:grid-cols-3">
            {
                philosophy.map((item) => (
                    <div class="philosophy-card">
                        <h3 class="philosophy-title">{item.title}</h3>
                        <p class="philosophy-text">{item.text}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!--
  ======================================================================
  EDUCATION & CERTIFICATES
  ======================================================================
-->
    <section class="home-section container md:px-12">
        <div class="section-label-row">
            <h2 class="section-label"><span>//</span> education</h2>
        </div>

        <div class="degree-card md:grid-cols-[auto_1fr_auto]">
            <span class="degree-icon" aria-hidden="true">B.S.</span>
            <div>
                <h3 class="degree-title">{degree.title}</h3>
                <p class="degree-school">{degree.school} · {degree.year}</p>
            </div>
            <a
                href={degree.pdf}
                target="_blank"
                rel="noopener"
                class="cta-button cta-button-ghost cta-button-sm"
                data-metric-id="view-degree"
            >
                ./view-diploma
            </a>
        </div>
    </section>

    <!--
  ======================================================================
  SELF-LEARNING (Udemy certificates)
  ======================================================================
-->
    <section class="home-section container md:px-12">
        <div class="section-label-row">
            <h2 class="section-label"><span>//</span> self_learning</h2>
            <span class="section-hint"
                >{certs.length} certificates · {totalHours} hours</span
            >
        </div>
        <p class="section-intro">
            Udemy courses I've completed on my own time, going deeper into game
            engines, languages, and tools outside the classroom.
        </p>
        <div class="term-window">
            <div class="term-window-bar">
                <span class="term-window-dot"></span>
                <span class="term-window-dot"></span>
                <span class="term-window-dot"></span>
                <span class="term-window-title">~/skills/certs</span>
            </div>
            <div class="ls-body">
                <p class="term-prompt">
                    <span class="term-dollar">$</span> ls -l certs/
                </p>
                <p class="ls-total">total {totalHours}h</p>
                <ul class="ls-list">
                    {
                        certs.map((cert) => (
                            <li>
                                <a
                                    href={cert.pdf}
                                    target="_blank"
                                    rel="noopener"
                                    class="ls-row md:grid-cols-[6rem_4rem_1fr_auto]"
                                >
                                    <span class="ls-date">
                                        {formatDate(cert.date)}
                                    </span>
                                    <span class="ls-hours">{cert.hours}h</span>
                                    <span class="ls-name">{cert.title}</span>
                                    <span class="ls-open">open .pdf →</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </section>

    <!--
  ======================================================================
  CALL TO ACTION
  ======================================================================
-->
    <section class="home-section container md:px-12 md:pb-32">
        <div class="term-window">
            <div class="term-window-bar">
                <span class="term-window-dot"></span>
                <span class="term-window-dot"></span>
                <span class="term-window-dot"></span>
                <span class="term-window-title">next.sh</span>
            </div>
            <div
                class="term-window-body skills-cta md:flex-row md:items-center md:p-12"
            >
                <div>
                    <p class="term-prompt">
                        <span class="term-dollar">$</span> ./see-it-in-action
                    </p>
                    <h2 class="home-contact-title md:text-5xl">
                        Skills are better
                        <span>in action.</span>
                    </h2>
                </div>
                <a href="/myWork/" class="cta-button">./view-work</a>
            </div>
        </div>
    </section>
</Layout>
