---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets' // Import Astro's image component for optimized image handling

import websiteThumbnail from '../assets/images/website-screenshot.png' // Import thumbnail image for astro website project
import iosAppThumbnail from '../assets/images/hp.png' // Import thumbnail image for iOS app project
import robotThumbnail from '../assets/images/robot.png' // Import thumbnail image for Unreal Engine project
---

<Layout title="Stephen Sterling - My Work">
    <!-- Work-Hero Section -->
    <section
        id="hero-section"
        class="py-48 text-center md:py-72"
    >
        <!-- Content Container -->
        <div class="container relative z-10 mx-auto px-6">
            <!-- Page Title -->
            <h1
                class="text-6xl font-bold leading-tight text-text md:text-8xl lg:text-9xl"
            >
                My Work<span class="text-accent">.</span>
            </h1>
            <p class="mx-auto mt-4 max-w-2xl text-lg text-text md:text-xl">
                A selection of projects I've built, from game prototypes to
                modern web applications.
            </p>
        </div>
    </section>

    <!-- Main Projects Grid Section -->
    <section class="py-16 md:py-24">
        <!-- Content Container -->
        <div class="container mx-auto px-6">
            <!-- Project Cards -->
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                <!-- Project Card 1 -->
                <div
                    class="project-card flex flex-col overflow-hidden rounded-2xl"
                >
                    <div class="relative">
                        <Image
                            src={websiteThumbnail}
                            alt="Astro Website Thumbnail"
                            class="h-56 w-full object-cover opacity-5"
                            loading="lazy"
                        />
                        <h2
                            class="absolute top-0 w-full p-6 pt-16 text-4xl font-bold text-accent"
                        >
                            Astro Website
                        </h2>
                    </div>

                    <div class="flex flex-grow flex-col px-6 pb-6">
                        <h3 class="pb-2 text-2xl text-text">
                            Portfolio Website
                        </h3>
                        <p class="mt-2 flex-grow pb-2 text-text">
                            A showcase of modern web development in action. This
                            portfolio was built from the ground up with Astro
                            for maximum performance and a seamless user
                            experience, styled with Tailwind CSS. It features a
                            fully automated CI/CD pipeline, deploying directly
                            from GitHub to Cloudflare's edge network.
                        </p>
                        <div class="mt-4 flex flex-wrap gap-2">
                            <span
                                class="tech-tag"
                                >Astro</span
                            ><span
                                class="tech-tag"
                                >HTML</span
                            ><span
                                class="tech-tag"
                                >Tailwind CSS</span
                            ><span
                                class="tech-tag"
                                >Javascript</span
                            >
                        </div>
                        <div class="mt-6 flex items-center space-x-4">
                            <a
                                href="https://github.com/ssterling9928/sterlingdev-website"
                                class="button"
                                target="_blank"
                                data-metric-id="view-website-source-code"
                            >
                                Source Code
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Project Card 2 -->
                <div
                    class="project-card flex flex-col overflow-hidden rounded-2xl"
                >
                    <div class="relative">
                        <Image
                            src={iosAppThumbnail}
                            alt="iOS App Thumbnail"
                            class="h-56 w-full object-cover opacity-5"
                            loading="lazy"
                        />
                        <h2
                            class="absolute top-0 w-full p-6 pt-16 text-4xl font-bold"
                        >
                            iOS App
                        </h2>
                    </div>
                    <div class="flex flex-grow flex-col p-6">
                        <h3 class="text-2xl text-text">
                            Wizard's Quiz
                        </h3>
                        <p class="mt-2 flex-grow text-text">
                            A native iOS trivia application built entirely in
                            Swift using Xcode and the UIKit framework, which is
                            currently published on the App Store. This project
                            demonstrates core iOS development principles,
                            including programmatic UI and state management.
                        </p>

                        <div class="mt-4 flex flex-wrap gap-2">
                            <span
                                class="tech-tag"
                                >Swift</span
                            ><span
                                class="tech-tag"
                                >Xcode</span
                            ><span
                                class="tech-tag"
                                >UIKit</span
                            >
                        </div>
                        <div class="mt-6 flex items-center space-x-4">
                            <a
                                href="https://apps.apple.com/us/app/wizards-quiz/id1502868673"
                                target="_blank"
                                class="button"
                                data-metric-id="view-ios-appstore">App Store</a
                            ><a
                                href="https://github.com/ssterling9928/HarryPotterTriviaQuiz"
                                target="_blank"
                                class="button"
                                data-metric-id="view-ios-source-code"
                                >Source Code</a
                            >
                        </div>
                    </div>
                </div>

                <!-- Project Card 3 -->
                <div
                    class="project-card flex flex-col overflow-hidden rounded-2xl"
                >
                    <div class="relative">
                        <Image
                            src={robotThumbnail}
                            alt="Robot Takeover Thumbnail"
                            class="h-56 w-full object-cover opacity-5"
                            loading="lazy"
                        />
                        <h2
                            class="absolute top-0 w-full p-6 pt-16 text-4xl font-bold text-accent"
                        >
                            Web Game
                        </h2>
                    </div>
                    <div class="flex flex-grow flex-col p-6">
                        <h3 class="text-2xl text-text">
                            Robot Takeover
                        </h3>
                        <p class="mt-2 flex-grow text-text">
                            This project is a complete JavaScript rewrite of an
                            original text-based adventure game I built in Unity.
                            The goal was to modernize the gameplay experience by
                            creating a fast, responsive, and immersive web
                            application with a stylized terminal interface,
                            bringing a classic game format to the browser.
                        </p>
                        <div class="mt-4 flex flex-wrap gap-2">
                            <span
                                class="tech-tag"
                                >Unity</span
                            ><span
                                class="tech-tag"
                                >C#</span
                            ><span
                                class="tech-tag"
                                >Javascript</span
                            >
                        </div>
                        <div class="mt-6 flex items-center space-x-4">
                            <a
                                href="/robotGame/"
                                class="button"
                                data-metric-id="view-robot-game">Live Demo</a
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Technologies Section -->
    <section class="py-16 md:py-24" style="background-color: #0D1117;">
        <div class="container mx-auto px-6">
            <div class="mb-16 text-center">
                <!-- THE CHANGE: Revamped title -->
                <h2 class="text-5xl font-bold text-text">
                    <span class="text-accent"
                        >Primary Technologies</span
                    >
                </h2>
                <p class="mt-4 text-lg text-text">
                    The core technologies I enjoy working with most.
                </p>
            </div>
            <!-- THE CHANGE: Revamped logo cards -->
            <div
                class="flex flex-wrap items-center justify-center gap-8 md:gap-12"
            >
                <div class="rounded-full p-4">
                    <img
                        src="https://placehold.co/80x80/ffffff/000000?text=UE5"
                        alt="Unreal Engine 5"
                        class="h-16 w-16 md:h-20 md:w-20"
                    />
                </div>
                <div class="rounded-full p-4">
                    <img
                        src="https://placehold.co/80x80/ffffff/000000?text=C%2B%2B"
                        alt="C++"
                        class="h-16 w-16 md:h-20 md:w-20"
                    />
                </div>
                <div class="rounded-full p-4">
                    <img
                        src="https://placehold.co/80x80/ffffff/000000?text=C%23"
                        alt="C#"
                        class="h-16 w-16 md:h-20 md:w-20"
                    />
                </div>
                <div class="rounded-full p-4">
                    <img
                        src="https://placehold.co/80x80/ffffff/000000?text=Git"
                        alt="Git"
                        class="h-16 w-16 md:h-20 md:w-20"
                    />
                </div>
                <div class="rounded-full p-4">
                    <img
                        src="https://placehold.co/80x80/ffffff/000000?text=Unity"
                        alt="Unity"
                        class="h-16 w-16 md:h-20 md:w-20"
                    />
                </div>
            </div>
        </div>
    </section>
</Layout>
