---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'

import coverImage from '../assets/images/robot.png'
import { scenes } from '../data/robotTakeover'

// --- Counts shown in the header, worked out from the story itself ---------
// A losing scene sends every choice to GAME OVER (X1); the winning scene
// sends every choice back to the main menu.
const leadsOnlyTo = (key: string) =>
    scenes.filter(
        (scene) =>
            scene.key !== key &&
            scene.key !== 'GameMenu' &&
            (scene.options ?? []).length > 0 &&
            (scene.options ?? []).every((choice) => choice.nextState === key)
    ).length

const stats = [
    { value: scenes.length, label: 'scenes' },
    {
        value: new Set(
            scenes.flatMap((scene) =>
                (scene.options ?? []).flatMap((choice) =>
                    choice.addItem ? [choice.addItem] : []
                )
            )
        ).size,
        label: 'items',
    },
    { value: leadsOnlyTo('GameMenu'), label: 'way to win' },
    { value: leadsOnlyTo('X1'), label: 'ways to lose' },
]

const howItWorks = [
    {
        title: 'unity → browser',
        text: 'The original was a C# project in Unity. This version is plain JavaScript, so it loads instantly and runs on any phone or laptop.',
    },
    {
        title: 'a state machine',
        text: `Each of the ${scenes.length} scenes is a piece of data: its text and the choices that lead to other scenes. The engine just moves between them.`,
    },
    {
        title: 'items unlock paths',
        text: 'Pick up the wrench and a locked panel opens. Some choices only appear when you carry the right item.',
    },
]
---

<Layout title="Stephen Sterling - Robot Takeover">
    <!--
  ======================================================================
  HEADER: title, counts and cover art
  ======================================================================
-->
    <section class="robot-hero container md:grid-cols-[1.15fr_1fr] md:px-12 md:py-20">
        <div>
            <p class="term-prompt">
                <span class="term-dollar">$</span> ./robot-takeover
            </p>
            <h1 class="robot-title md:text-6xl lg:text-7xl">
                Robot{' '}
                <span class="nowrap">
                    <span class="robot-title-accent">Takeover.</span>
                    <span class="term-cursor" aria-hidden="true"></span>
                </span>
            </h1>
            <p class="robot-subtitle md:text-xl">
                A text adventure I first built in Unity, rewritten in JavaScript
                to run in the browser. The machines run the world. Find a way to
                shut them down.
            </p>
            <ul class="robot-stats">
                {stats.map((stat) => (
                    <li>
                        <b>{stat.value}</b> {stat.label}
                    </li>
                ))}
            </ul>
            <div class="robot-actions">
                <a href="#play" class="cta-button" data-metric-id="robot-play">
                    ./play
                </a>
                <a href="/myWork/" class="cta-button cta-button-ghost">
                    ./all-projects
                </a>
            </div>
        </div>
        <div class="robot-cover">
            <Image
                src={coverImage}
                alt="Robot Takeover cover art: a chrome robot skull with red eyes"
                width={960}
                loading="eager"
            />
            <span class="case-badge">web game</span>
        </div>
    </section>

    <!--
  ======================================================================
  THE GAME
  ======================================================================
  Filled in by the script below. Number keys pick a choice; Enter (or a
  click on the story) skips the typing.
-->
    <section id="play" class="home-section container md:px-12">
        <div class="section-label-row">
            <h2 class="section-label">
                <span>//</span> play
            </h2>
            <span class="section-hint">keys 1–9 or click · Enter skips</span>
        </div>
        <div class="term-window">
            <div class="term-window-bar game-bar">
                <span class="term-window-dot"></span>
                <span class="term-window-dot"></span>
                <span class="term-window-dot"></span>
                <span class="term-window-title">robot-takeover.sh</span>
                <span class="game-inventory" data-game-inventory>
                    inventory: [ ]
                </span>
            </div>
            <div class="game-body md:px-8 md:py-7">
                <p
                    class="game-text md:text-lg"
                    data-game-text
                    aria-live="polite"
                ></p>
                <div class="game-options" data-game-options></div>
                <p class="game-prompt">
                    <span>
                        <span class="term-dollar">$</span>
                        <span data-game-prompt>...</span>
                    </span>
                    <span data-game-scene></span>
                </p>
                <noscript>
                    <p class="game-text">
                        Robot Takeover needs JavaScript to run.
                    </p>
                </noscript>
            </div>
        </div>
    </section>

    <!--
  ======================================================================
  HOW IT WORKS
  ======================================================================
-->
    <section class="home-section container md:px-12 md:pb-32">
        <div class="section-label-row">
            <h2 class="section-label">
                <span>//</span> how_it_works
            </h2>
        </div>
        <div class="robot-how md:grid-cols-3">
            {howItWorks.map((item) => (
                <div class="robot-how-card">
                    <h3 class="robot-how-title">{item.title}</h3>
                    <p class="robot-how-text">{item.text}</p>
                </div>
            ))}
        </div>
    </section>
</Layout>

<script>
    import { scenes, START_SCENE, type Choice } from '../data/robotTakeover'

    const byKey = new Map(scenes.map((scene) => [scene.key, scene]))
    const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
    ).matches

    const text = document.querySelector<HTMLElement>('[data-game-text]')!
    const options = document.querySelector<HTMLElement>('[data-game-options]')!
    const prompt = document.querySelector<HTMLElement>('[data-game-prompt]')!
    const sceneLabel = document.querySelector<HTMLElement>('[data-game-scene]')!
    const inventoryLabel = document.querySelector<HTMLElement>(
        '[data-game-inventory]'
    )!

    let current = START_SCENE
    let inventory: string[] = []
    let fullText = ''
    let typingTimer: number | undefined

    const isTyping = () => typingTimer !== undefined

    // Choices the player can take right now (some need an item).
    function availableChoices(): Choice[] {
        return (byKey.get(current)?.options ?? []).filter(
            (choice) => !choice.requires || inventory.includes(choice.requires)
        )
    }

    function showChoices() {
        options.replaceChildren()
        const choices = availableChoices()
        choices.forEach((choice, index) => {
            const button = document.createElement('button')
            button.type = 'button'
            button.className = 'game-option'
            const key = document.createElement('kbd')
            key.textContent = `[${index + 1}]`
            button.appendChild(key)
            button.appendChild(document.createTextNode(choice.text))
            button.addEventListener('click', () => choose(choice))
            options.appendChild(button)
        })
        prompt.textContent = choices.length
            ? `select an option [1-${choices.length}]`
            : 'the story ends here. reload the page to play again.'
    }

    function finishTyping() {
        window.clearTimeout(typingTimer)
        typingTimer = undefined
        text.textContent = fullText
        text.classList.remove('is-typing')
        showChoices()
    }

    function show(key: string) {
        const scene = byKey.get(key)
        if (!scene) {
            console.error(`Robot Takeover: scene "${key}" not found`)
            return
        }
        current = key
        fullText = scene.text
        sceneLabel.textContent = `scene ${key}`
        options.replaceChildren()
        prompt.textContent = '...'
        window.clearTimeout(typingTimer)

        if (reduceMotion) {
            finishTyping()
            return
        }
        let shown = 0
        text.classList.add('is-typing')
        const step = () => {
            shown += 2
            text.textContent = fullText.slice(0, shown)
            if (shown < fullText.length) {
                typingTimer = window.setTimeout(step, 18)
            } else {
                finishTyping()
            }
        }
        step()
    }

    function choose(choice: Choice) {
        if (choice.addItem && !inventory.includes(choice.addItem)) {
            inventory.push(choice.addItem)
        }
        // Starting over from the menu clears the bag.
        if (choice.nextState === START_SCENE) inventory = []
        inventoryLabel.textContent = inventory.length
            ? `inventory: [ ${inventory.join(', ')} ]`
            : 'inventory: [ ]'
        show(choice.nextState)
    }

    text.addEventListener('click', () => {
        if (isTyping()) finishTyping()
    })

    document.addEventListener('keydown', (event) => {
        // Leave typing in the contact form alone.
        const target = event.target as HTMLElement | null
        if (target?.closest('input, textarea, select, [contenteditable]'))
            return
        if (event.metaKey || event.ctrlKey || event.altKey) return

        if (event.key === 'Enter' && isTyping()) {
            event.preventDefault()
            finishTyping()
            return
        }
        const number = Number.parseInt(event.key, 10)
        if (!isTyping() && number > 0) {
            const choice = availableChoices()[number - 1]
            if (choice) choose(choice)
        }
    })

    show(START_SCENE)
</script>
