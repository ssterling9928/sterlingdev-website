---
interface Props {
    title?: string // Optional title prop for the document, defaults to 'Stephen Sterling - Portfolio'
}

const { title } = Astro.props

import '../styles/global.css' // Import global styles
import Header from '../components/Header.astro'
import CommandMenu from '../components/react/command/commandmenu.tsx'
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title || 'Stephen Sterling - Portfolio'}</title>
        <script is:inline defer src="/scripts/metrics.js"></script>

        <!-- Google Font -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fira+Sans+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Inter:wght@400;500;600;700;800;900&family=Source+Code+Pro:wght@400;600&display=swap"
            rel="stylesheet"
        />
    </head>

    <body>
        <Header siteTitle="Stephen Sterling" />

        <slot />
        {/* This is where the content of each page will go */}

        <!-- Command Menu -->
        <CommandMenu client:idle />
        <!-- Footer -->
        <footer class="site-footer">
            <div class="container">
                <p>
                    &copy; {new Date().getFullYear()} Stephen Sterling. All rights
                    reserved.
                </p>
            </div>
        </footer>

        <!-- CONTACT MODAL -->
        <div id="contact-modal" class="modal-hidden contact-modal">
            <!-- Modal Overlay -->
            <div id="modal-overlay" class="modal-overlay"></div>

            <!-- Modal Content: a small terminal window -->
            <div
                class="modal-panel term-window"
                role="dialog"
                aria-modal="true"
                aria-labelledby="contact-modal-title"
            >
                <div class="term-window-bar">
                    <span class="term-window-dot"></span>
                    <span class="term-window-dot"></span>
                    <span class="term-window-dot"></span>
                    <span class="term-window-title">contact.sh</span>
                    <button
                        id="close-contact-modal"
                        type="button"
                        class="modal-close"
                        aria-label="Close"
                    >
                        esc ✕
                    </button>
                </div>

                <div class="modal-body">
                    <p class="term-prompt">
                        <span class="term-dollar">$</span> ./contact
                    </p>
                    <h2 id="contact-modal-title" class="modal-title">
                        Let's <span class="modal-title-accent">connect.</span>
                    </h2>
                    <p class="modal-subtitle">
                        Find me on these platforms, send an email, or grab my
                        resume.
                    </p>

                    <ul class="modal-links">
                        <li>
                            <a
                                href="https://github.com/ssterling9928"
                                target="_blank"
                                rel="noopener"
                                class="modal-link"
                                data-metric-id="open-github"
                            >
                                <svg
                                    class="modal-link-icon"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                    ><path
                                        fill-rule="evenodd"
                                        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.47.087.67-.23.67-.483 0-.237-.008-.86-.013-1.688-2.782.603-3.369-1.34-3.369-1.34-.454-1.157-1.11-1.464-1.11-1.464-.908-.62.069-.607.069-.607 1.004.07 1.532 1.03 1.532 1.03.89 1.528 2.336 1.088 2.906.83.09-.645.35-1.088.636-1.338-2.22-.253-4.555-1.115-4.555-4.945 0-1.09.39-1.984 1.03-2.68a3.57 3.57 0 01.1-2.652s.836-.268 2.747 1.026c.79-.22 1.63-.33 2.47-.33.84 0 1.68.11 2.47.33 1.91-1.294 2.747-1.026 2.747-1.026.182.556.326 1.134.1 2.652.64.696 1.03 1.59 1.03 2.68 0 3.84-2.339 4.686-4.568 4.935.35.3.67.92.67 1.855 0 1.34-.012 2.427-.012 2.75 0 .25.197.575.676.474C20.137 20.217 23 16.46 23 12.017 23 6.484 18.522 2 12 2z"
                                        clip-rule="evenodd"></path></svg
                                >
                                <span class="modal-link-name">github</span>
                                <span class="modal-link-value"
                                    >ssterling9928</span
                                >
                                <span
                                    class="modal-link-arrow"
                                    aria-hidden="true">→</span
                                >
                            </a>
                        </li>
                        <li>
                            <a
                                href="https://linkedin.com/in/stephen-sterling-9514a41a2/"
                                target="_blank"
                                rel="noopener"
                                class="modal-link"
                                data-metric-id="open-linkedin"
                            >
                                <svg
                                    class="modal-link-icon"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                    ><path
                                        d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 006-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z"
                                    ></path></svg
                                >
                                <span class="modal-link-name">linkedin</span>
                                <span class="modal-link-value"
                                    >Stephen Sterling</span
                                >
                                <span
                                    class="modal-link-arrow"
                                    aria-hidden="true">→</span
                                >
                            </a>
                        </li>
                        <li>
                            <a
                                href="mailto:stephen@sterling-dev.com"
                                class="modal-link"
                                data-metric-id="open-email"
                            >
                                <svg
                                    class="modal-link-icon"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                    aria-hidden="true"
                                    ><path
                                        d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                                    ></path><path
                                        d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                                    ></path></svg
                                >
                                <span class="modal-link-name">email</span>
                                <span class="modal-link-value"
                                    >stephen@sterling-dev.com</span
                                >
                                <span
                                    class="modal-link-arrow"
                                    aria-hidden="true">→</span
                                >
                            </a>
                        </li>
                    </ul>

                    <a
                        href="/assets/resume/Sterling-Resume.pdf"
                        download="Stephen_Sterling_Resume.pdf"
                        class="cta-button modal-resume"
                        data-metric-id="resume-download"
                    >
                        ./download-resume.pdf
                    </a>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Calculate and set the height of the -- Hero section
                const header = document.getElementById('header')
                const heroSection = document.getElementById('hero-section')

                function calculateHeroHeight() {
                    // Not every page has a hero section (e.g. robotGame)
                    if (!header || !heroSection) return

                    const headerHeight = header.offsetHeight
                    heroSection.style.minHeight = `calc(100vh - ${headerHeight}px)`
                }

                calculateHeroHeight()

                window.addEventListener('resize', calculateHeroHeight)

                // Contact Modal functionality
                // Open and close modal functionality

                const openModalBtns = document.querySelectorAll(
                    '.open-contact-modal'
                )

                const closeModalBtn = document.getElementById(
                    'close-contact-modal'
                )

                const modal = document.getElementById('contact-modal')
                const overlay = document.getElementById('modal-overlay')

                // Remember what opened the modal so focus can go back to it
                let lastFocused: HTMLElement | null = null

                const openModal = () => {
                    if (modal) {
                        lastFocused =
                            document.activeElement as HTMLElement | null
                        modal.classList.remove('modal-hidden')
                        closeModalBtn?.focus()
                    }
                }

                const closeModal = () => {
                    if (modal) {
                        modal.classList.add('modal-hidden')
                        lastFocused?.focus()
                    }
                }

                if (openModalBtns) {
                    openModalBtns.forEach((btn) => {
                        btn.addEventListener('click', (e) => {
                            e.preventDefault() // prevents the link from navigating
                            openModal()
                        })
                    })
                }

                if (closeModalBtn) {
                    closeModalBtn.addEventListener('click', closeModal)
                }

                if (overlay) {
                    overlay.addEventListener('click', closeModal)
                }

                // Also close with the Escape key
                document.addEventListener('keydown', (e) => {
                    if (
                        e.key === 'Escape' &&
                        modal &&
                        !modal.classList.contains('modal-hidden')
                    ) {
                        closeModal()
                    }
                })
            })
        </script>
    </body>
</html>
